MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/workhub_db?appName=Cluster0

PORT=5000
REDIS_URL=redis://redis:6379
JWT_SECRET=<replace-with-strong-secret>
JWT_REFRESH_SECRET=<replace-with-strong-refresh-secret>

VITE_NODE_API_URL=http://localhost:5000
VITE_PYTHON_API_URL=http://localhost:8000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<email-user>
EMAIL_PASS=<email-app-password>
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=<google-client-id>
VITE_GOOGLE_CLIENT_ID=<google-client-id>

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=workhub-documents
R2_REGION=auto
MAX_UPLOAD_SIZE_MB=50

CLOUDFLARE_REALTIME_ACCOUNT_ID=<cloudflare-realtime-account-id>
CLOUDFLARE_REALTIME_APP_ID=<cloudflare-realtimekit-app-id>
CLOUDFLARE_REALTIME_API_TOKEN=<cloudflare-realtime-api-token>
CLOUDFLARE_REALTIME_HOST_PRESET=group_call_host
CLOUDFLARE_REALTIME_PARTICIPANT_PRESET=group_call_host
CLOUDFLARE_REALTIME_RECORD_ON_START=true
CLOUDFLARE_REALTIME_TRANSCRIPTION_LANGUAGE=vi
CLOUDFLARE_REALTIME_SUMMARY_WORD_LIMIT=500
CLOUDFLARE_REALTIME_SUMMARY_TEXT_FORMAT=markdown
CLOUDFLARE_REALTIME_SUMMARY_TYPE=team_meeting

CLOUDFLARE_AI_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_AI_API_TOKEN=<cloudflare-workers-ai-token>
CLOUDFLARE_AI_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_AI_SUMMARY_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_AI_SUMMARY_MAX_TOKENS=1400
CLOUDFLARE_AI_SUMMARY_TEMPERATURE=0.2
CLOUDFLARE_AI_SUMMARY_REPETITION_PENALTY=1.1
CLOUDFLARE_AI_TRANSCRIPTION_LANGUAGE=vi
CLOUDFLARE_AI_WHISPER_VAD_FILTER=false
CLOUDFLARE_AI_MAX_AUDIO_MB=25
CLOUDFLARE_AI_AUDIO_PREPROCESS=true
CLOUDFLARE_AI_AUDIO_PREPROCESS_TIMEOUT_MS=120000
